# Jira
JIRA_BASE_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=seu-email@invoisys.com
JIRA_API_TOKEN=

# Banco — Postgres (docker-compose já injeta o host "db"; local usa localhost)
POSTGRES_USER=invoisys
POSTGRES_PASSWORD=invoisys
POSTGRES_DB=invoisys
ConnectionStrings__Default=Host=localhost;Port=5432;Database=invoisys;Username=invoisys;Password=invoisys

# Auth
JWT_SECRET=troque-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=60

# App
LOG_LEVEL=INFO

# LLM — OpenRouter (gateway único, formato provedor/modelo)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Lista JSON opcional de modelos alternativos, tentados se o principal falhar (5xx/429)
# OPENROUTER_FALLBACK_MODELS=["anthropic/claude-3.5-sonnet"]
