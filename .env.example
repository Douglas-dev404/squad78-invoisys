# Copie para .env e preencha. O .NET lê variáveis de ambiente com "__" (dois
# underscores) como separador de seção: Jira__BaseUrl vira Jira:BaseUrl no
# appsettings. Nomes em outro formato (ex: JIRA_BASE_URL) são ignorados em silêncio.

# Jira Cloud — Basic Auth com e-mail + API token (não senha).
# Sem os três preenchidos, a API responde 501 "Jira não configurado".
Jira__BaseUrl=https://suaempresa.atlassian.net
Jira__Email=seu-email@invoisys.com
Jira__ApiToken=

# LLM — OpenRouter (gateway único, modelo no formato provedor/modelo).
# Sem a chave, /processar responde 501 "Nenhum LLM provider configurado".
OpenRouter__ApiKey=
OpenRouter__Modelo=openai/gpt-4o-mini
# Modelos alternativos, tentados pela própria OpenRouter se o principal falhar (5xx/429).
# Um por índice:
# OpenRouter__ModelosFallback__0=anthropic/claude-3.5-sonnet

# Banco — Postgres. O docker-compose usa POSTGRES_* para criar o banco e sobrescreve
# a connection string com o host "db"; rodando a API fora do Docker, vale a linha abaixo.
POSTGRES_USER=invoisys
POSTGRES_PASSWORD=invoisys
POSTGRES_DB=invoisys
ConnectionStrings__Default=Host=localhost;Port=5432;Database=invoisys;Username=invoisys;Password=invoisys

# Auth — reservado para a autenticação JWT (ainda não implementada; nada lê estas
# variáveis hoje). Os nomes finais serão definidos junto com o endpoint de login.
# Jwt__Secret=troque-em-producao
# Jwt__ExpiraMinutos=60
