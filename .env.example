# Copie para .env e preencha. O .NET lê variáveis de ambiente com "__" (dois
# underscores) como separador de seção: Jira__BaseUrl vira Jira:BaseUrl no
# appsettings. Nomes em outro formato (ex: JIRA_BASE_URL) são ignorados em silêncio.

# Jira Cloud — Basic Auth com e-mail + API token (não senha).
# Sem os três preenchidos, a API responde 501 "Jira não configurado".
Jira__BaseUrl=https://suaempresa.atlassian.net
Jira__Email=seu-email@invoisys.com
Jira__ApiToken=

# LLM — OpenRouter (gateway único, modelo no formato provedor/modelo).
# Sem a chave, /processar responde 501 "Nenhum LLM provider configurado".
OpenRouter__ApiKey=
OpenRouter__Modelo=openai/gpt-4o-mini
# Modelos alternativos, tentados pela própria OpenRouter se o principal falhar (5xx/429).
# Um por índice:
# OpenRouter__ModelosFallback__0=anthropic/claude-3.5-sonnet

# LLM — escolha do provedor: OpenRouter (padrão) ou OpenAi.
Llm__Provedor=OpenRouter
# OpenAI direto. NUNCA commitar a chave: ela vai só no seu .env local (ignorado pelo Git).
# Com Llm__Provedor=OpenAi e sem a chave, /processar responde 501.
OpenAi__ApiKey=
OpenAi__Modelo=gpt-4o-mini

# Banco — Postgres. O docker-compose usa POSTGRES_* para criar o banco e sobrescreve
# a connection string com o host "db"; rodando a API fora do Docker, vale a linha abaixo.
POSTGRES_USER=invoisys
POSTGRES_PASSWORD=invoisys
POSTGRES_DB=invoisys
ConnectionStrings__Default=Host=localhost;Port=5432;Database=invoisys;Username=invoisys;Password=invoisys

# Auth — JWT Bearer (ADR-024). Diferente de Jira/LLM, não existe modo "pendente":
# sem Auth__Jwt__Chave a API não sobe. Mínimo de 32 caracteres; gere com: openssl rand -base64 48
# Trocar a chave invalida todos os tokens já emitidos.
Auth__Jwt__Chave=
Auth__Jwt__Emissor=invoisys
Auth__Jwt__Audiencia=invoisys-api
Auth__Jwt__ExpiracaoHoras=8

# Admin inicial — criado no startup só se NÃO existir nenhum usuário e os três campos
# estiverem preenchidos. Idempotente. Depois do primeiro login, troque a senha e apague
# Auth__AdminInicial__Senha do .env.
Auth__AdminInicial__Email=
Auth__AdminInicial__Senha=
Auth__AdminInicial__Nome=

# CORS — uma origem por índice. Sem nenhuma, nenhum site externo é liberado.
Cors__Origens__0=http://localhost:5173
# Rate limit do login, por IP.
RateLimit__Login__Tentativas=5
RateLimit__Login__JanelaSegundos=60
# Atrás de proxy reverso (Render, nginx): conta o rate limit pelo IP real do cliente
# (X-Forwarded-For). Deixe false sem proxy, senão qualquer um forja o cabeçalho.
Proxy__ConfiarCabecalhosEncaminhados=false


# Recuperação de senha (ADR-025). UrlBase é obrigatória: URL absoluta da tela de
# redefinição do front; o link enviado é UrlBase#token=<token>. Sem SMTP, o link sai no log
# da API (nível Warning): só use isso em desenvolvimento.
Auth__RecuperacaoSenha__UrlBase=http://localhost:5173/redefinir-senha
# Intervalo mínimo entre dois e-mails para o mesmo usuário.
Auth__RecuperacaoSenha__CooldownSegundos=60
# Rate limit por IP nos endpoints forgot-password e resend-forgot-password.
Auth__RecuperacaoSenha__LimiteRequisicoes=5
Auth__RecuperacaoSenha__JanelaMinutos=15
